{
  "name": "daily-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:check": "tsx scripts/content.ts --check",
    "content:build": "tsx scripts/content.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run content:build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "remark-parse": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "unified": "^11.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "yaml": "^2.8.0"
  }
}
